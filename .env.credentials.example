# Copy to .env.credentials (git-ignored) and load it in EVERY terminal:
#   set -a; source .env.credentials; set +a
# This single file feeds the AWS CLI, Terraform, the Go producer and tests/aws.
# Do not commit real values.

# --- AWS credentials: a static access key ---
# Do NOT set AWS_PROFILE: with keys in the environment it is not needed, and a profile
# name that does not exist makes the AWS CLI and boto3 fail even when the keys are valid.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Only for temporary credentials (access keys starting with ASIA):
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# --- Producer (Go) ---
# STREAM_NAME is the output of `terraform output -raw stream_name`.
STREAM_NAME=logistics-events
PORT=8080

# Automatic emitter: the producer publishes a batch of simulated events every EMIT_INTERVAL.
# Leave EMIT_INTERVAL empty (or 0) to disable it. EMIT_PACKAGES = simulated packages (1-100).
EMIT_INTERVAL=25s
EMIT_PACKAGES=3
